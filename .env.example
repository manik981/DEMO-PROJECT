# Required: create an API key at https://console.groq.com/keys
GROQ_API_KEY=

# Model ID. Verified working default: openai/gpt-oss-120b
# Other options on the Groq free tier may include openai/gpt-oss-20b and qwen/qwen3.8-27b.
GROQ_MODEL=openai/gpt-oss-120b

# Optional limits (defaults shown)
# MAX_UPLOAD_MB=10
# MAX_DOCUMENT_CHARS=120000
# DIRECT_ANALYSIS_CHARS=24000
# CHUNK_CHARS=12000
# CHUNK_OVERLAP_CHARS=800
# MAX_CHUNKS=8
# MAX_OUTPUT_TOKENS=8192
# REQUEST_TIMEOUT_SECONDS=90
# MAX_RETRIES=2
# TEMPERATURE=0.1
