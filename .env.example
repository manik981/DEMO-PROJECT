# Required: create an API key for the Agnes API hub.
AGNES_API_KEY=

# Agnes model and OpenAI-compatible base URL.
AGNES_MODEL=agnes-2.5-flash
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# Optional limits (defaults shown)
# MAX_UPLOAD_MB=10
# MAX_DOCUMENT_CHARS=120000
# DIRECT_ANALYSIS_CHARS=24000
# CHUNK_CHARS=12000
# CHUNK_OVERLAP_CHARS=800
# MAX_CHUNKS=8
# MAX_OUTPUT_TOKENS=16000
# Request budget (prompt + completion). Agnes 2.5 Flash supports a 512K context
# window and 65,536 output tokens; these defaults stay conservative.
# MAX_REQUEST_TOKENS=64000
# Maximum items per findings category (3-50). When the cap is reached the app
# analyzes bounded document sections and reports has_more instead of failing.
# MAX_FINDINGS_PER_CATEGORY=10
# REQUEST_TIMEOUT_SECONDS=90
# MAX_RETRIES=3
# TEMPERATURE=0.1
