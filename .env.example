# LLM Provider API Keys & Configurable Model IDs


GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-3.5-turbo

# Open Source / GitHub Token (for research paper star extraction)
GITHUB_TOKEN=your_github_token_here

# Google Sheets Export Configuration
GOOGLE_SHEETS_CREDS_PATH=credentials.json
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_or_url_here
# Database Storage (PostgreSQL / Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# External API Integrations - Configured Keys
ZENSERP_API_KEY=your_zenserp_api_key_here
USAJOBS_API_KEY=your_usajobs_api_key_here
USAJOBS_API_EMAIL=developer@example.com
NEWSFLASH_API_KEY=your_newsflash_api_key_here
NEWS_FLASH_API_KEY=your_newsflash_api_key_here
GNEWS_API_KEY=your_gnews_api_key_here
GUARDIAN_API_KEY=your_guardian_api_key_here
RAPIDAPI_KEY=your_rapidapi_key_here
